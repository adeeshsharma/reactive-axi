{
  "name": "reactive-axi",
  "version": "0.0.3",
  "description": "Click any element in your live React app and send feedback straight to your coding agent, resolved to the exact source file and line.",
  "type": "module",
  "homepage": "https://github.com/adeeshsharma/reactive-axi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeeshsharma/reactive-axi.git",
    "directory": "packages/reactive-axi"
  },
  "bugs": {
    "url": "https://github.com/adeeshsharma/reactive-axi/issues"
  },
  "author": {
    "name": "Adeesh Sharma",
    "url": "https://github.com/adeeshsharma"
  },
  "bin": {
    "reactive-axi": "bin/reactive-axi.js"
  },
  "files": [
    "dist",
    "plugin.json",
    "skills/reactive-editor",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:skill": "node scripts/build-skill.js",
    "build:plugin": "node scripts/build-plugin.js",
    "start": "node dist/cli.mjs",
    "lint": "eslint bin src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run lint && npm run format:check && npm run typecheck && npm test && node scripts/build-skill.js --check && node scripts/build-plugin.js --check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "axi",
    "agent",
    "cli",
    "react",
    "devtools",
    "review",
    "collaboration"
  ],
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "axi-sdk-js": "^0.1.10",
    "cross-spawn": "^7.0.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "launch-editor-middleware": "^2.14.1",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
}
